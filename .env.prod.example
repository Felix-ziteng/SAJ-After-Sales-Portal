# Copy to .env on the EC2 instance (next to docker-compose.prod.yml). Never commit the real one.

# --- Docker Hub image source ---
# Your Docker Hub username — images are pulled as <user>/saj-backend:latest and <user>/saj-frontend:latest.
DOCKERHUB_USERNAME=changeme

# --- Database ---
DB_NAME=aftersales
DB_USERNAME=aftersales
DB_PASSWORD=change-me-to-a-real-password
DB_ROOT_PASSWORD=change-me-to-a-different-real-password

# --- Backend ---
AUTH_PROVIDER=password
# Bootstrap Admin account, seeded once on first boot if this email doesn't exist yet.
ADMIN_BOOTSTRAP_EMAIL=felix
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-real-password
ADMIN_BOOTSTRAP_DISPLAY_NAME=Admin
# Stays false for IP+HTTP. Flip to true only once this is served over real HTTPS (a domain +
# TLS cert) — a plain-HTTP browser silently drops Secure cookies, which would break login.
COOKIE_SECURE=false
# Same-origin via the nginx proxy in prod, so this normally doesn't matter — set it to
# http://<your-ec2-public-ip> anyway in case anything ever calls the API directly.
CORS_ALLOWED_ORIGINS=http://CHANGE-ME-TO-YOUR-EC2-PUBLIC-IP
