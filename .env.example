# Copy to .env for docker-compose. Never commit the real .env.

# --- Database ---
DB_NAME=aftersales
DB_USERNAME=aftersales
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Host-side port only (container always listens on 3306 internally) — kept off 3306 by
# default so it doesn't collide with a MySQL instance already running on the host.
DB_HOST_PORT=3307

# --- Backend ---
BACKEND_PORT=8080
# mock (dev only, no real login) | entra (future — Microsoft Entra ID)
AUTH_PROVIDER=mock
# Flyway (src/main/resources/db/migration) owns the schema now — Hibernate just validates.
JPA_DDL_AUTO=validate

# --- Frontend ---
FRONTEND_PORT=3000
# Must be reachable from the browser, not just the Docker network — the frontend calls this
# client-side, so it stays the host-published backend port even inside docker-compose.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
